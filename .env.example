# Logowanie do /wyniki.html: e-mail + token (jeden rodzic, widzi wszystkich uczniów)
ADMIN_EMAIL=
ADMIN_TOKEN=

# Przypomnienie tokenu mailem (SMTP). Bez SMTP_HOST przypomnienia nie wychodzą.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# nadawca, domyślnie SMTP_USER, np. Fiszki <fiszki@twojadomena.pl>
SMTP_FROM=
# starttls (587, domyślnie) | ssl (465) | none
SMTP_SECURITY=
# link w mailu
PUBLIC_URL=https://fiszki.ktd.pl/wyniki.html
