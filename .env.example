# Logowanie do /wyniki.html: e-mail + token (jeden rodzic, widzi wszystkich uczniów)
ADMIN_EMAIL=
ADMIN_TOKEN=

# Przypomnienie tokenu mailem. Bez SMTP_HOST i SMTP_FROM przypomnienia nie wychodzą.
# VPS fiszki.ktd.pl: przekaźnik Google Workspace, autoryzacja po IP serwera - bez logowania.
SMTP_HOST=smtp-relay.gmail.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_FROM=Fiszki <fiszki@ktd.pl>
# Tylko dla zwykłego SMTP z logowaniem (np. smtp.gmail.com + hasło aplikacji); przy przekaźniku zostaw puste.
SMTP_USER=
SMTP_PASSWORD=
# EHLO: domyślnie domena z SMTP_FROM (ktd.pl)
SMTP_HELO=
# starttls (587) | ssl (465) | none

# link w mailu
PUBLIC_URL=https://fiszki.ktd.pl/wyniki.html
